class_v_f_de14b4ae	v	[RelVal]	game/tl/deutsch/scene/classroom.rpy	571	v sad "[what]"
class_v_f_6680f428	v	Oh, du bist böse!	game/tl/deutsch/scene/classroom.rpy	577	v evil "[what]"

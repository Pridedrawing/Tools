ned_bio_02fba128		Beziehung = [LoveNed]	game/tl/deutsch/scene/biography/ned_bio.rpy	1716	"[what]"
ned_bio_d7029b0f		Ihre Beziehung zu Ned lässt sich am besten als gegenseitige Abscheu beschreiben. Es ist nicht klar, ob zwischen Ihnen noch etwas zu retten ist.	game/tl/deutsch/scene/biography/ned_bio.rpy	1719	"[what]"
ned_bio_02fba128_1		Beziehung = [LoveNed]	game/tl/deutsch/scene/biography/ned_bio.rpy	1722	"[what]"

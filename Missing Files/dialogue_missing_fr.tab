p_julian_c4c44ecf	c	Mais je lui ai fait boire du whisky.	game/tl/french/scene/party.rpy	24350	"c evil ""[what]"""
p_julian_fa46e59f	c	Et il aime ça !	game/tl/french/scene/party.rpy	24353	"c happy ""[what]"""
p_julian_d7f39b9c	c	Je doute qu'il se souvienne de quoi que ce soit d'ici demain.	game/tl/french/scene/party.rpy	24356	"c tough ""[what]"""

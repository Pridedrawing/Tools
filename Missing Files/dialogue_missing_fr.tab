cafe_bf0baf4c	c	Ron, voici Ned. Il est également étudiant.	game/tl/french/scene/cafe.rpy	14918	"c friendly ""[what]"""
cafe_e2a615e4	r	Enchanté de vous rencontrer.	game/tl/french/scene/cafe.rpy	14921	"r friendly ""[what]"""

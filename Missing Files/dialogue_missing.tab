class_v_f_accad5d5	v	Oh, du meinst, weil ich nicht so clever bin wie Ned?	game/tl/deutsch/scene/classroom.rpy	721	v happy "[what]"
class_v_f_79e4a059	c	Das habe ich nicht gesagt...du drehst mir die Worte im Mund herum.	game/tl/deutsch/scene/classroom.rpy	727	c shy "[what]"

p_julian_0910c0be	j	[RelVal]	game/tl/french/scene/party.rpy	10073	"j happy ""[what]"""
p_julian_07107465	c	Tu sais quoi, Julian ? Tout ça me met mal à l'aise.	game/tl/french/scene/party.rpy	24398	"c tough ""[what]"""
p_julian_752b7a64	c	Je veux dire, sérieusement. Tu vas baiser ta meilleure amie, dont tu sais qu'elle est amoureuse de toi.	game/tl/french/scene/party.rpy	24401	"c sad ""[what]"""
p_julian_d12b5560	c	Même si tu es hétéro et... et quoi ?	game/tl/french/scene/party.rpy	24404	"c suspicious ""[what]"""
p_julian_2f6476ab	c	Vous allez lui donner de l'espoir et le larguer ensuite ?	game/tl/french/scene/party.rpy	24407	"c angry ""[what]"""
p_julian_3ae6afeb	j	VA TE FAIRE FOUTRE ! !!	game/tl/french/scene/party.rpy	24410	"j angry ""[what]"" with vpunch"
p_julian_5486ee96	c	Si vous pensez que vous pouvez simplement avoir des relations sexuelles avec lui, sans conditions, vous allez avoir une mauvaise surprise.	game/tl/french/scene/party.rpy	24413	"c angry ""[what]"""

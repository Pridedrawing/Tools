office_ee7aa42a		Das ist ernst. Wirklich ernst. Du fängst an zu schwitzen.	game/tl/deutsch/scene/office.rpy	193	"[what]"
office_bc8161ab	c	Es muss etwas geben, was ich tun kann!	game/tl/deutsch/scene/office.rpy	199	c down "[what]"

locker_v_a19d3434	n	Va te faire foutre ! Tu n'es qu'un joueur et tes jeux ne m'intéressent pas.	game/tl/french/scene/locker.rpy	8485	"n angry ""[what]"""
locker_v_559729c9_3	n	[RelVal]	game/tl/french/scene/locker.rpy	3277	"n sad ""[what]"""
locker_v_7ac73416	n	Bien sûr ! J'aurais dû m'en douter.	game/tl/french/scene/locker.rpy	8488	"n angry ""[what]"""

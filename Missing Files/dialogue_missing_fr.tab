p_julian_6a7ebc1a		Julian vous lance un regard blessant.	game/tl/french/scene/party.rpy	24368	[what]
p_julian_0af906f9	j	Vous avez peut-être raison.	game/tl/french/scene/party.rpy	24371	"j down ""[what]"""
p_julian_b36ff6ec	j	[RelVal]	game/tl/french/scene/party.rpy	10067	"j angry ""[what]"""
p_julian_486239b4	c	Je pense qu'il va rester sobre ce soir.	game/tl/french/scene/party.rpy	24374	"c neutral ""[what]"""
p_julian_d3969f65	c	Et je doute qu'il ait bu beaucoup de bière.	game/tl/french/scene/party.rpy	24377	"c suspicious ""[what]"""
p_julian_40dfc673		Julian soupire.	game/tl/french/scene/party.rpy	24380	[what]
p_julian_973ebc6a	j	Je suppose que je vais devoir mettre une autre pilule dans sa boisson gazeuse alors.	game/tl/french/scene/party.rpy	24383	"j sad ""[what]"""
p_julian_31285a54		Vous haussez les épaules.	game/tl/french/scene/party.rpy	24386	[what]
p_julian_e45e5f74	c	Je suppose que c'est le cas.	game/tl/french/scene/party.rpy	24389	"c neutral ""[what]"""
p_julian_c330bb3c		Vous le regardez mettre une autre pilule dans une boisson gazeuse.	game/tl/french/scene/party.rpy	24392	[what]
